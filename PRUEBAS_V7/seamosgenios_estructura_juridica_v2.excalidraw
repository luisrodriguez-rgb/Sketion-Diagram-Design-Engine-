pdated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1838630891,"isDeleted":false,"id":"pAQGmRBrePKXGUN8","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1826.0,"y":132.0,"strokeColor":"#64748B","backgroundColor":"transparent","width":519.0,"height":25.0,"seed":580397826,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":11,"fontFamily":3,"text":"3. MATRIZ RBAC (LEAST PRIVILEGE) & MARKETING (LEY 2300)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3. MATRIZ RBAC (LEAST PRIVILEGE) & MARKETING (LEY 2300)","lineHeight":1.25,"baseline":11},{"type":"rectangle","version":1,"versionNonce":2145812649,"isDeleted":false,"id":"xwZxMHZTDmVceSqv","fillStyle":"solid","strokeWidth":1.0,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.017453292500000002,"x":1835.0,"y":170.0,"strokeColor":"#0C0C0C","backgroundColor":"#FFE95C","width":880.0,"height":175.0,"seed":591241268,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":null,"boundElements":[{"id":"wRqymyVMqGAihCUb","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1641144256,"isDeleted":false,"id":"wRqymyVMqGAihCUb","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.017453292500000002,"x":1835.0,"y":204.85,"strokeColor":"#0C0C0C","backgroundColor":"transparent","width":880.0,"height":105.30000000000001,"seed":155922750,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":2,"text":"MATRIZ DE PERMISOS POR ROL (LEAST PRIVILEGE):\n\n• Tutores: Solo acceden a estudiantes asignados y notas. CERO datos financieros ni teléfonos de padres.\n• Padres: Solo consultan avance y asistencia de sus propios hijos (CERO acceso a terceros).\n• Colegios B2B: Solo acceden al cohorte de su institución contratada.\n• Administradores: Acceso restringido por 2FA a finanzas, facturación y contratos.","textAlign":"center","verticalAlign":"middle","containerId":"xwZxMHZTDmVceSqv","originalText":"MATRIZ DE PERMISOS POR ROL (LEAST PRIVILEGE):\n\n• Tutores: Solo acceden a estudiantes asignados y notas. CERO datos financieros ni teléfonos de padres.\n• Padres: Solo consultan avance y asistencia de sus propios hijos (CERO acceso a terceros).\n• Colegios B2B: Solo acceden al cohorte de su institución contratada.\n• Administradores: Acceso restringido por 2FA a finanzas, facturación y contratos.","lineHeight":1.25,"baseline":13,"autoResize":true},{"type":"rectangle","version":1,"versionNonce":1363777780,"isDeleted":false,"id":"hf0sf4HVv5Monkbz","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":370.0,"strokeColor":"#86EFAC","backgroundColor":"#F0FDF4","width":880.0,"height":230.0,"seed":73232050,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":{"type":3},"boundElements":[{"id":"KulX4tpMwPA79veC","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1167602532,"isDeleted":false,"id":"KulX4tpMwPA79veC","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":436.4,"strokeColor":"#0F172A","backgroundColor":"transparent","width":880.0,"height":97.2,"seed":1957619789,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":2,"text":"RÉGIMEN DE COMUNICACIONES COMERCIALES Y MARKETING (LEY 2300 DE 2023):\n\n• Separación estricta: Comunicaciones del servicio (clases, notas) vs Marketing (promociones).\n• Preferencias por canal registradas en base de datos: Email, WhatsApp, SMS, Llamadas.\n• Horarios legales estrictos: Lunes a viernes 7:00 a 19:00, sábados 8:00 a 15:00.\n• Mecanismo de cancelación en un solo clic ('Opt-Out') en todo mensaje comercial enviado.","textAlign":"left","verticalAlign":"middle","containerId":"hf0sf4HVv5Monkbz","originalText":"RÉGIMEN DE COMUNICACIONES COMERCIALES Y MARKETING (LEY 2300 DE 2023):\n\n• Separación estricta: Comunicaciones del servicio (clases, notas) vs Marketing (promociones).\n• Preferencias por canal registradas en base de datos: Email, WhatsApp, SMS, Llamadas.\n• Horarios legales estrictos: Lunes a viernes 7:00 a 19:00, sábados 8:00 a 15:00.\n• Mecanismo de cancelación en un solo clic ('Opt-Out') en todo mensaje comercial enviado.","lineHeight":1.25,"baseline":12,"autoResize":true},{"type":"rectangle","version":1,"versionNonce":844676733,"isDeleted":false,"id":"YEiOZZWfZyjKi15a","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":620.0,"strokeColor":"#CBD5E1","backgroundColor":"#F8FAFC","width":880.0,"height":235.0,"seed":183256080,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":{"type":3},"boundElements":[{"id":"Ox5e6cOzRzGPEJ7M","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":209020688,"isDeleted":false,"id":"Ox5e6cOzRzGPEJ7M","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":688.9,"strokeColor":"#0F172A","backgroundColor":"transparent","width":880.0,"height":97.2,"seed":1662372036,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":2,"text":"RÉGIMEN DE PROPIEDAD INTELECTUAL & BANCO DE PREGUNTAS:\n\n• Activos protegidos: Banco de preguntas ICFES, simulacros, guías, PDFs, videos, plataforma.\n• Prohibición expresa de copia, redistribución, reventa o extracción masiva (scraping).\n• Contratos de tutores con cláusulas de cesión patrimonial y confidencialidad estricta.\n• Regla de Oro: El acceso al contenido académico NO equivale a transferencia de propiedad.","textAlign":"left","verticalAlign":"middle","containerId":"YEiOZZWfZyjKi15a","originalText":"RÉGIMEN DE PROPIEDAD INTELECTUAL & BANCO DE PREGUNTAS:\n\n• Activos protegidos: Banco de preguntas ICFES, simulacros, guías, PDFs, videos, plataforma.\n• Prohibición expresa de copia, redistribución, reventa o extracción masiva (scraping).\n• Contratos de tutores con cláusulas de cesión patrimonial y confidencialidad estricta.\n• Regla de Oro: El acceso al contenido académico NO equivale a transferencia de propiedad.","lineHeight":1.25,"baseline":12,"autoResize":true},{"type":"text","version":1,"versionNonce":1718002571,"isDeleted":false,"id":"6sRXgkZ0YPiYva9Y","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":60.0,"y":3225.0,"strokeColor":"#64748B","backgroundColor":"transparent","width":87.80000000000001,"height":25.0,"seed":99879022,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":11,"fontFamily":2,"text":"LEGEND","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"LEGEND","lineHeight":1.25,"baseline":11},{"type":"rectangle","version":1,"versionNonce":1112416453,"isDeleted":false,"id":"hJ871Velcbnjk0fa","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":130.0,"y":3225.0,"strokeColor":"#D93829","backgroundColor":"#FFF5F2","width":24.0,"height":14.0,"seed":1348733645,"groupIds":[],"frameId":"qnT8Pg2stFFFpnHV","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1751729080,"isDeleted":false,"id":"lUKYIIgEdRxSb4Vr","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":160.0,"y":3226.0,"strokeColor":"#334155","backgroundColor":"transparent","width":255.00000000000003,"height":25.0,"seed":1640343710,"groupIds":[],"frameId":"qnT8Pg2stF