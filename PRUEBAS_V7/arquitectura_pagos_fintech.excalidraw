],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":2,"text":"POLÍTICA DE RESILIENCIA OPERATIVA:\n\n1. Todo fallo transitorio se reintenta con Exponential Backoff y Jitter.\n2. Todo fallo definitivo se aísla en la Dead Letter Queue (DLQ).\n3. Ningún centavo se pierde en tránsito entre el cliente y el banco.","textAlign":"center","verticalAlign":"middle","containerId":"ADMCo6iKAlKPFVsF","originalText":"POLÍTICA DE RESILIENCIA OPERATIVA:\n\n1. Todo fallo transitorio se reintenta con Exponential Backoff y Jitter.\n2. Todo fallo definitivo se aísla en la Dead Letter Queue (DLQ).\n3. Ningún centavo se pierde en tránsito entre el cliente y el banco.","lineHeight":1.25,"baseline":13,"autoResize":true},{"type":"rectangle","version":1,"versionNonce":139929489,"isDeleted":false,"id":"n3y5dsTwmyWODsg9","fillStyle":"solid","strokeWidth":1.0,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1900.0,"y":2415.0,"strokeColor":"#CBD5E1","backgroundColor":"#FFFFFF","width":990.0,"height":760.0,"seed":1085300218,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":325400295,"isDeleted":false,"id":"Jbnl0jROY74qGFrJ","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1916.0,"y":2427.0,"strokeColor":"#64748B","backgroundColor":"transparent","width":519.0,"height":25.0,"seed":1964872372,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":11,"fontFamily":3,"text":"3. CONCILIACIÓN BANCARIA NOCTURNA & OBSERVABILIDAD 24/7","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3. CONCILIACIÓN BANCARIA NOCTURNA & OBSERVABILIDAD 24/7","lineHeight":1.25,"baseline":11},{"type":"rectangle","version":1,"versionNonce":1815758151,"isDeleted":false,"id":"gtXUj2dgZXREdcme","fillStyle":"solid","strokeWidth":1.5,"