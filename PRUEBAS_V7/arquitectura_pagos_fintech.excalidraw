      "version": 2,
      "versionNonce": 1629812059,
      "isDeleted": false,
      "id": "3rHsxz68hgc6wsHB",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 956,
