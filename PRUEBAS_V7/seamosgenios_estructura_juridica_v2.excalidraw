ada o producto no recibido.\n• Procedimiento coordinado entre SEAMOSGENIOS, pasarela Bold y entidad bancaria emisora.\n• Notificación oportuna dentro de los 5 días hábiles posteriores a la noticia del fraude.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Aplica en supuestos legales: Fraude electrónico, operación no solicitada o producto no recibido.\n• Procedimiento coordinado entre SEAMOSGENIOS, pasarela Bold y entidad bancaria emisora.\n• Notificación oportuna dentro de los 5 días hábiles posteriores a la noticia del fraude.","lineHeight":1.25,"baseline":12},{"type":"rectangle","version":1,"versionNonce":1168886563,"isDeleted":false,"id":"GfL3agWHNxm49H9y","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":25.0,"y":2960.0,"strokeColor":"#CBD5E1","backgroundColor":"#F8FAFC","width":780.0,"height":175.0,"seed":1682215520,"groupIds":[],"frameId":"B4VDyCDDxtvvmwTE","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"rectangle","version":1,"versionNonce":2028853123,"isDeleted":false,"id":"jxAdMdcWi41wwVHG","fillStyle":"solid","strokeWidth":1.0,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":39.0,"y":2972.0,"strokeColor":"#CBD5E1","backgroundColor":"#F1F5F9","width":145.6,"height":20.0,"seed":1854701046,"groupIds":[],"frameId":"B4VDyCDDxtvvmwTE","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":801155267,"isDeleted":false,"id":"DomUnEN8P8WkBCY5","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":43.0,"y":2974.0,"strokeColor":"#475569","backgroundColor":"transparent","width":179.0,"height":25.0,"seed":1901816597,"groupIds":[],"frameId":"B4VDyCDDxtvvmwTE","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":10,"fontFamily":2,"text":"CLÁUSULA EDUCATIVA","textAlign":"left","ve