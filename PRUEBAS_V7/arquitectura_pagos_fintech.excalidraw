e":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1936.0,"y":2496.0,"strokeColor":"#0F172A","backgroundColor":"transparent","width":647.0,"height":25.0,"seed":1847275663,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"Nightly Reconciliation Worker (Conciliación Diaria)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Nightly Reconciliation Worker (Conciliación Diaria)","lineHeight":1.25,"baseline":15},{"type":"text","version":1,"versionNonce":720533599,"isDeleted":false,"id":"a49uwbVQ2psAzwTc","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1936.0,"y":2520.0,"strokeColor":"#334155","backgroundColor":"transparent","width":975.8000000000002,"height":90.0,"seed":712098913,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":2,"text":"• Cruce automatizado diario de archivos de liquidación bancaria (.CAMT / .BAI2) vs Ledger interno.\n• Identificación automática de 3 estados de conciliación:\n•   • Match Exacto: Monto, fecha y referencia coinciden (99.8% de operaciones).\n•   • Diferencia de Comisión: Ajuste contable por tarifas de adquirente.\n•   • Transacción Huérfana: Alerta prioritaria para conciliación manual por equipo financiero.\n• Generación de reportes de balance y certificación de fondos para auditoría externa.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"• Cruce automatizado diario de archivos de liquidación bancaria (.CAMT / .BAI2) vs Ledger interno.\n• Identificación automática de 3 estados de conciliación:\n•   • Match Exacto: Monto, fecha y referencia coinciden (99.8% de operaciones).\n•   • Diferencia de Comisión: Ajuste contable por tarifas de adquirente.\n•   • Transacción Huérfana: Alerta prioritaria para conciliación manual por equipo financiero.\n• Generación de reportes de balance y certificación de fondos para auditoría externa.","lineHeight":1.25,"baseline":12},{"type":"rectangle","version":1,"versionNonce":1057814764,"isDeleted":false,"id":"t4DicU9EmCfUvT5y","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1920.0,"y":2715.0,"strokeColor":"#93C5FD","backgroundColor":"#EFF6FF","width":950.0,"height":240.0,"seed":1961979938,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"rectangle","version":1,"versionNonce":635771675,"isDeleted":false,"id":"DkbDTzBoWOhx0zFg","fillStyle":"solid","strokeWidth":1.0,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1934.0,"y":2727.0,"strokeColor":"#CBD5E1","backgroundColor":"#F1F5F9","width":124.0,"height":20.0,"seed":943985627,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1108748803,"isDeleted":false,"id":"tDr3sSwqc5WQX7aZ","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1938.0,"y":2729.0,"strokeColor":"#475569","backgroundColor":"transparent","width":155.0,"height":25.0,"seed":1162317489,"groupIds":[],"frameId":"uneVYx9WH1ijNln6","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":10,"fontFamily":2,"text":"TELEMETRÍA 24/7","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"TELEMETRÍA 24/7","lineHeight":1.25,"baseline":10},{"type":"image","version":1,"versionNonce":50172000,"isDeleted":false,"id":"bPwKzfZWWylq4LPj","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":2832.0,"y":2727.0,"strokeColor":"transparent","backgroundColor":"transparent","width":22.0,"height":22.0,"seed":250039557,"g