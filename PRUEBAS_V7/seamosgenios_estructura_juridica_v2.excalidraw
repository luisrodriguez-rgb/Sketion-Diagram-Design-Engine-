width":810.0,"height":185.0,"seed":598979270,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":{"type":3},"boundElements":[{"id":"3Z5FV648gpkwgIog","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":642114464,"isDeleted":false,"id":"3Z5FV648gpkwgIog","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":940.0,"y":3005.8,"strokeColor":"#0F172A","backgroundColor":"transparent","width":810.0,"height":113.4,"seed":2131208448,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":2,"text":"FLUJO HÁBEAS DATA Y TIEMPOS LEGALES DE RESPUESTA:\n\nSolicitud ──► Radicación Única ──► Identificación ──► Clasificación ──► Validación ──► Respuesta\n\n• Peticiones de información y consultas: 10 días hábiles (prorrogables 5 días).\n• Reclamos de protección de datos: 15 días hábiles (prorrogables 8 días, Ley 1581).\n• Historial inmutable de solicitudes archivado por 5 años para sustento ante la SIC.","textAlign":"left","verticalAlign":"middle","containerId":"4wFejlxC74nSjNmM","originalText":"FLUJO HÁBEAS DATA Y TIEMPOS LEGALES DE RESPUESTA:\n\nSolicitud ──► Radicación Única ──► Identificación ──► Clasificación ──► Validación ──► Respuesta\n\n• Peticiones de información y consultas: 10 días hábiles (prorrogables 5 días).\n• Reclamos de protección de datos: 15 días hábiles (prorrogables 8 días, Ley 1581).\n• Historial inmutable de solicitudes archivado por 5 años para sustento ante la SIC.","lineHeight":1.25,"baseline":12,"autoResize":true},{"type":"rectangle","version":1,"versionNonce":1756378258,"isDeleted":false,"id":"zLeo7TFW0BGkaChO","fillStyle":"solid","strokeWidth":1.0,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1810.0,"y":2420.0,"strokeColor":"#CBD5E1","backgroundColor":"#FFFFFF","width":930.0,"height":760.0,"seed":1917297064,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":62645140,"isDeleted":false,"id":"WrYu2UmX1QAC4wk2","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1826.0,"y":2432.0,"strokeColor":"#64748B","backgroundColor":"transparent","width":519.0,"height":25.0,"seed":556079162,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":11,"fontFamily":3,"text":"3. MATRIZ RBAC (LEAST PRIVILEGE) & MARKETING (LEY 2300)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3. MATRIZ RBAC (LEAST PRIVILEGE) & MARKETING (LEY 2300)","lineHeight":1.25,"baseline":11},{"type":"rectangle","version":1,"versionNonce":1137024410,"isDeleted":false,"id":"IG0wuLEgLwapoEZw","fillStyle":"solid","strokeWidth":1.0,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.017453292500000002,"x":1835.0,"y":2470.0,"strokeColor":"#0C0C0C","backgroundColor":"#FFE95C","width":880.0,"height":175.0,"seed":470278383,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[{"id":"CiPlSDdPVkgyvvoa","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1473699594,"isDeleted":false,"id":"CiPlSDdPVkgyvvoa","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.017453292500000002,"x":1835.0,"y":2504.85,"strokeColor":"#0C0C0C","backgroundColor":"transparent","width":880.0,"height":105.30000000000001,"seed":160496429,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":2,"text":"MATRIZ DE PERMISOS POR ROL (LEAST PRIVILEGE):\n\n• Tutores: Solo acceden a estudiantes asignados y notas. CERO datos financieros ni teléfonos de padres.\n• Padres: Solo consultan avance y asistencia de sus propios hijos (CERO acceso a terceros).\n• Colegios B2B: Solo acceden al cohorte de su institución contratada.\n• Administradores: Acceso restringido por 2FA a finanzas, facturación y contratos.","textAlign":"center","verticalAlign":"middle","containerId":"IG0wuLEgLwapoEZw","originalText":"MATRIZ DE PERMISOS POR ROL (LEAST PRIVILEGE):\n\n• Tutores: Solo acceden a estudiantes asignados y notas. CERO datos financieros ni teléfonos de padres.\n• Padres: Solo consultan avance y asistencia de sus propios hijos (CERO acceso a terceros).\n• Colegios B2B: Solo acceden al cohorte de su institución contratada.\n• Administradores: Acceso restringido por 2FA a finanzas, facturación y contratos.","lineHeight":1.25,"baseline":13,"autoResize":true},{"type":"rectangle","version":1,"versionNonce":1735941032,"isDeleted":false,"id":"OIwUqLo6bx2lhXPL","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":2670.0,"strokeColor":"#86EFAC","backgroundColor":"#F0FDF4","width":880.0,"height":230.0,"seed":1809436971,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":{"type":3},"boundElements":[{"id":"BaxUSZeM1bOn89kO","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1225981426,"isDeleted":false,"id":"BaxUSZeM1bOn89kO","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":2736.4,"strokeColor":"#0F172A","backgroundColor":"transparent","width":880.0,"height":97.2,"seed":1912766591,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":2,"text":"RÉGIMEN DE COMUNICACIONES COMERCIALES Y MARKETING (LEY 2300 DE 2023):\n\n• Separación estricta: Comunicaciones del servicio (clases, notas) vs Marketing (promociones).\n• Preferencias por canal registradas en base de datos: Email, WhatsApp, SMS, Llamadas.\n• Horarios legales estrictos: Lunes a viernes 7:00 a 19:00, sábados 8:00 a 15:00.\n• Mecanismo de cancelación en un solo clic ('Opt-Out') en todo mensaje comercial enviado.","textAlign":"left","verticalAlign":"middle","containerId":"OIwUqLo6bx2lhXPL","originalText":"RÉGIMEN DE COMUNICACIONES COMERCIALES Y MARKETING (LEY 2300 DE 2023):\n\n• Separación estricta: Comunicaciones del servicio (clases, notas) vs Marketing (promociones).\n• Preferencias por canal registradas en base de datos: Email, WhatsApp, SMS, Llamadas.\n• Horarios legales estrictos: Lunes a viernes 7:00 a 19:00, sábados 8:00 a 15:00.\n• Mecanismo de cancelación en un solo clic ('Opt-Out') en todo mensaje comercial enviado.","lineHeight":1.25,"baseline":12,"autoResize":true},{"type":"rectangle","version":1,"versionNonce":1830364136,"isDeleted":false,"id":"2TK7tnAbzWHNyMDg","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":2920.0,"strokeColor":"#CBD5E1","backgroundColor":"#F8FAFC","width":880.0,"height":235.0,"seed":634396429,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":{"type":3},"boundElements":[{"id":"QCFOL7y6zVQ2CDuF","type":"text"}],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":347351918,"isDeleted":false,"id":"QCFOL7y6zVQ2CDuF","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":1835.0,"y":2988.9,"strokeColor":"#0F172A","backgroundColor":"transparent","width":880.0,"height":97.2,"seed":1483970393,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":2,"text":"RÉGIMEN DE PROPIEDAD INTELECTUAL & BANCO DE PREGUNTAS:\n\n• Activos protegidos: Banco de preguntas ICFES, simulacros, guías, PDFs, videos, plataforma.\n• Prohibición expresa de copia, redistribución, reventa o extracción masiva (scraping).\n• Contratos de tutores con cláusulas de cesión patrimonial y confidencialidad estricta.\n• Regla de Oro: El acceso al contenido académico NO equivale a transferencia de propiedad.","textAlign":"left","verticalAlign":"middle","containerId":"2TK7tnAbzWHNyMDg","originalText":"RÉGIMEN DE PROPIEDAD INTELECTUAL & BANCO DE PREGUNTAS:\n\n• Activos protegidos: Banco de preguntas ICFES, simulacros, guías, PDFs, videos, plataforma.\n• Prohibición expresa de copia, redistribución, reventa o extracción masiva (scraping).\n• Contratos de tutores con cláusulas de cesión patrimonial y confidencialidad estricta.\n• Regla de Oro: El acceso al contenido académico NO equivale a transferencia de propiedad.","lineHeight":1.25,"baseline":12,"autoResize":true},{"type":"text","version":1,"versionNonce":994845947,"isDeleted":false,"id":"VPgQeKsMetzHljXy","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":60.0,"y":3225.0,"strokeColor":"#64748B","backgroundColor":"transparent","width":87.80000000000001,"height":25.0,"seed":2086296604,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":null,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":11,"fontFamily":2,"text":"LEGEND","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"LEGEND","lineHeight":1.25,"baseline":11},{"type":"rectangle","version":1,"versionNonce":1571047324,"isDeleted":false,"id":"Q6Idsinil9wdYWxV","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":130.0,"y":3225.0,"strokeColor":"#D93829","backgroundColor":"#FFF5F2","width":24.0,"height":14.0,"seed":106602707,"groupIds":[],"frameId":"uDJ3QmMxq1rbNCyX","roundness":{"type":3},"boundElements":[],"updated":1,"link":null,"locked":false},{"type":"text","version":1,"versionNonce":1055056036,"isDeleted":false,"id":"fxj1bG4bSPILBlPR","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0.0,"x":160.0,"y":3226.0,"strokeColor":"#334155","backgroundColor":"transparent","width":255.00000000000003,"height":25.0,"