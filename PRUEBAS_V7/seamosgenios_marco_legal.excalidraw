    {
      "id": "txt_c722ec17",
      "type": "text",
      "x": 3405.0,
      "y": 650.0,
      "text": "LOG INMUTABLE DE CONSENTIMIENTOS (AUDIT TRAIL)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
